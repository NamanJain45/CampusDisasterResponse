generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  STAFF
  ADMIN
}

enum EmergencySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SafetyStatus {
  UNKNOWN
  SAFE
  TRAPPED
  NEED_FIRST_AID
  NEED_ASSISTANCE
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(STUDENT)

  statuses      UserStatus[]
  sosEvents     SOS[]
  locations     Location[]

  syncSequence  Int            @default(autoincrement())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([updatedAt])
  @@index([syncSequence])
}

model Emergency {
  id            String             @id @default(uuid())
  title         String
  message       String
  severity      EmergencySeverity
  active        Boolean            @default(true)
  activatedBy   String?

  syncSequence  Int                @default(autoincrement())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([updatedAt])
  @@index([syncSequence])
}

model SOS {
  id            String       @id @default(uuid())
  clientId      String?      @unique
  userId        String
  latitude      Float?
  longitude     Float?
  message       String?
  active        Boolean      @default(true)

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  syncSequence  Int          @default(autoincrement())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([updatedAt])
  @@index([syncSequence])
}

model UserStatus {
  id            String        @id @default(uuid())
  clientId      String?       @unique
  userId        String
  status        SafetyStatus
  message       String?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  syncSequence  Int           @default(autoincrement())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([updatedAt])
  @@index([syncSequence])
}

model Location {
  id            String       @id @default(uuid())
  clientId      String?      @unique
  userId        String
  latitude      Float
  longitude     Float
  recordedAt    DateTime

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  syncSequence  Int          @default(autoincrement())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId])
  @@index([updatedAt])
  @@index([syncSequence])
}

model SyncLog {
  id              String    @id @default(uuid())
  userId          String?
  clientActionId  String?   @unique
  actionType      String
  success         Boolean
  errorMessage    String?

  syncSequence    Int       @default(autoincrement())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
  @@index([syncSequence])
}
